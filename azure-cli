#!/usr/bin/env bash
# azure-cli - thin launcher so "azure-cli"/"$AZVICLI_EXE" stays a single
# executable token everywhere the old azure-cli.exe was invoked as one
# (git-bash, resolve-pat.sh, azure-cli.lua's jobstart calls, ...).
# Delegates straight to the python data provider next to this script.
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if command -v python3 >/dev/null 2>&1; then
  exec python3 "$DIR/azure-cli.py" "$@"
fi
if command -v python >/dev/null 2>&1; then
  exec python "$DIR/azure-cli.py" "$@"
fi

echo "azure-cli: python was not found on PATH - it runs the data provider (azure-cli.py)." >&2
echo "Install Python 3 (https://www.python.org/downloads/, or 'bash install.sh'), then run this again." >&2
exit 127
